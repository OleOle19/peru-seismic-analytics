{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProjectObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {"StringLike": {"s3:prefix": ["peru-seismic/*"]}}
    },
    {
      "Sid": "ReadWriteProjectObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/peru-seismic/*"
    }
  ]
}

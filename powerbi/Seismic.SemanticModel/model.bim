          },
          {
            "name": "zone",
            "dataType": "string",
            "sourceColumn": "zone",
            "summarizeBy": "none"
          },
          {
            "name": "latitude_min",
            "dataType": "double",
            "sourceColumn": "latitude_min",
            "summarizeBy": "none"
          },
          {
            "name": "latitude_max",
            "dataType": "double",
            "sourceColumn": "latitude_max",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Zona",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\", \"SeismicAnalytics\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"dbo\",Item=\"DimZone\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ]
      },
      {
        "name": "Magnitud",
        "columns": [

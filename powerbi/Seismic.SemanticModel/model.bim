    ],
    "relationships": [
      {
        "name": "Eventos_Calendario",
        "fromTable": "Eventos",
        "fromColumn": "date_key",
        "toTable": "Calendario",
        "toColumn": "date_key",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Eventos_Zona",
        "fromTable": "Eventos",
        "fromColumn": "zone_key",
        "toTable": "Zona",
        "toColumn": "zone_key",

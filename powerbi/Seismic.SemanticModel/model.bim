            "sourceColumn": "magnitude_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "magnitude_band",
            "dataType": "string",
            "sourceColumn": "magnitude_band",
            "summarizeBy": "none",
            "sortByColumn": "magnitude_key"
          },
          {
            "name": "magnitude_min",
            "dataType": "double",
            "sourceColumn": "magnitude_min",
            "summarizeBy": "none"
          },
          {
            "name": "magnitude_max",
            "dataType": "double",
            "sourceColumn": "magnitude_max",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
